{
  "name": "morning-star",
  "version": "3.1.1",
  "description": "Morning Star — harness engineering workflow platform: TS Harness Workflow Engine + judgment skills, shipped as an Agent Plugin",
  "private": true,
  "type": "module",
  "main": "packages/opencode/src/mstar.ts",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "bun run opencode:bundle-assets && bun run dsh:bundle-assets",
    "opencode:bundle-assets": "bun run --cwd packages/opencode bundle-assets",
    "dsh:bundle-assets": "bun run --cwd packages/dsh bundle-assets",
    "typecheck": "bunx tsc --pretty false",
    "engine:build": "bun run --cwd packages/engine build",
    "engine:pack": "npm pack --workspace @mstar-harness/engine",
    "cli:dev": "MSTAR_CLI_PROJECT_ROOT=$PWD bun run --cwd packages/cli dev",
    "cli:build": "bun run --cwd packages/cli build",
    "cli:pack": "npm pack --workspace @mstar-harness/cli",
    "opencode:build": "bun run --cwd packages/opencode build",
    "opencode:pack": "npm pack --workspace @mstar-harness/opencode",
    "dsh:build": "bun run --cwd packages/dsh build",
    "release:prepare": "bun run scripts/prepare-release.ts",
    "release:validate": "bun run scripts/validate-release-version.ts",
    "ci:dep-guard": "bun scripts/ci-dep-guard.ts",
    "validation:standalone": "bun run scripts/standalone-smoke.ts",
    "validation:drift": "bun run scripts/drift-lint.ts",
    "lint:ascii-literals": "bun scripts/lint-ascii-literals.ts"
  },
  "packageManager": "bun@1.2.17",
  "dependencies": {
    "@mstar-harness/engine": "workspace:*"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "^17.2.11",
    "@types/node": "^25.6.0"
  },
  "omp": {
    "name": "morning-star-harness",
    "description": "Morning Star multi-agent harness skills and iteration commands for omp."
  }
}

{
  "name": "@mstar-harness/engine",
  "version": "4.0.4",
  "description": "Morning Star Harness Workflow Engine \u2014 deterministic workflow enforcement library (path, status, lease, dispatch, sdd, iteration, lint gates).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/btspoony/mstar-harness.git",
    "directory": "packages/engine"
  },
  "type": "module",
  "main": "./dist/engine.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/engine.js"
    },
    "./package.json": "./package.json",
    "./src/audit": {
      "types": "./dist/audit.d.ts",
      "default": "./dist/audit.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && bun run scripts/build.ts && bunx tsc",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.18.0"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "bun-types": "^1.2.17",
    "typescript": "^7.0.2",
    "zod": "^4.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

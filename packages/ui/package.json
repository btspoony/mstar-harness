{
  "name": "@mstar-harness/ui",
  "version": "4.0.9",
  "description": "Host-agnostic React presentation layer for the Morning Star harness: design tokens, view models, components and bilingual copy.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/base.css": "./src/styles/base.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && bunx tsc --emitDeclarationOnly",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "check:classes": "bun run scripts/dead-classes.ts",
    "check:tones": "bun run scripts/tone-table.ts",
    "check:selectors": "bun run scripts/selector-diff.ts",
    "check:snapshot": "STRICT_SNAPSHOT=1 bun run design-system/snapshot.ts --check",
    "snapshot:write": "bun run design-system/snapshot.ts",
    "check:declarations": "bun run scripts/declaration-diff.ts",
    "check:stale": "bun run scripts/stale-assets.ts",
    "verify:visual": "bun run scripts/stale-assets.ts",
    "check:responsive": "bash scripts/responsive-sweep.sh",
    "check:mutation": "bash scripts/mutation-check.sh"
  },
  "devDependencies": {
    "@mstar-harness/engine": "workspace:*",
    "@types/node": "^26.6.4",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "bun-types": "^1.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  }
}

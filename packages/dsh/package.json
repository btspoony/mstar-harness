{
  "name": "@mstar-harness/dsh",
  "version": "2.0.4",
  "description": "Morning Star harness dsh (DeepSeek Harness SDK) cordis function plugin — in-process engine gates (status/dispatch/lease) with hard refusal channels.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./invariant": {
      "types": "./dist/invariant.d.ts",
      "default": "./dist/invariant.js"
    },
    "./bundle/cordis.patch.yml": "./bundle/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bundle",
    "skills/README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./bundle/cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "bun test",
    "build": "rm -rf dist && bun build src/index.ts src/invariant.ts --target node --outdir dist --external cordis --external @deepseek-ai/dsh-skill-local --external @deepseek-ai/dsh-tools --external @deepseek-ai/dsh-llm && bunx tsc",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "bun": ">=1.2.17"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.0.1",
    "@deepseek-ai/dsh-fs": "^0.0.1",
    "@deepseek-ai/dsh-fs-policy": "^0.0.1",
    "@deepseek-ai/dsh-llm": "^0.0.1",
    "@deepseek-ai/dsh-skill": "^0.0.1",
    "@deepseek-ai/dsh-skill-local": "^0.0.1",
    "@deepseek-ai/dsh-subagent": "^0.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1",
    "cordis": "^4.0.0-rc.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@cordisjs/plugin-include": "1.0.4",
    "@cordisjs/plugin-loader": "1.0.0-rc.5",
    "@deepseek-ai/dsh-agent": "^0.0.1",
    "@deepseek-ai/dsh-fs": "^0.0.1",
    "@deepseek-ai/dsh-fs-policy": "^0.0.1",
    "@deepseek-ai/dsh-invariants": "^0.0.1",
    "@deepseek-ai/dsh-llm": "^0.0.1",
    "@deepseek-ai/dsh-skill": "^0.0.1",
    "@deepseek-ai/dsh-skill-local": "^0.0.1",
    "@deepseek-ai/dsh-subagent": "^0.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1",
    "@mstar-harness/engine": "2.0.4",
    "@types/node": "^25.6.0",
    "js-yaml": "^4.1.0",
    "bun-types": "^1.2.17",
    "cordis": "^4.0.0-rc.7",
    "schemastery": "^3.18.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}

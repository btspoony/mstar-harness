{
  "name": "@mstar-harness/dsh",
  "version": "4.0.9",
  "description": "Morning Star harness dsh (DeepSeek Harness) cordis function plugin \u2014 in-process engine gates (status/dispatch/lease) with hard refusal channels.",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/btspoony/mstar-harness.git",
    "directory": "packages/dsh"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./invariant": {
      "types": "./dist/invariant.d.ts",
      "default": "./dist/invariant.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./bundle/cordis.patch.yml": "./bundle/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "SECURITY.md",
    "icon.svg",
    "dist",
    "bundle",
    "locale",
    "harness-skills",
    "harness-agents",
    "harness-commands"
  ],
  "dsh": {
    "bundle": {
      "patch": "./bundle/cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "pretest": "bun run build-client",
    "test": "bun test",
    "typecheck:tests": "bunx tsc --noEmit -p tests/tsconfig.json",
    "typecheck:src": "bunx tsc --noEmit -p tsconfig.json",
    "bundle-assets": "bun run scripts/bundle-harness-assets.ts",
    "build": "bun run --cwd ../commands build && bun run bundle-assets && rm -rf dist && bun build src/index.ts src/invariant.ts --target node --outdir dist --external @deepseek-ai/cordis --external @deepseek-ai/dsh-scope --external @deepseek-ai/dsh-skill-filesystem --external @deepseek-ai/dsh-tools --external @deepseek-ai/dsh-llm --external @deepseek-ai/dsh-storage-domain --external @mstar-harness/engine && bun run build-client && bunx tsc",
    "build-client": "bun run scripts/build-client-bundle.ts",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.18.0"
  },
  "dependencies": {
    "zod": "^4.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-default-model": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-preset": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-api-gateway": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-api-remotes": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-atomic-write": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-attachment": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-brand": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-chunked-list": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-file-upload": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-chat": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-commands": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-credentials": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-deque": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-file-reference": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-fs": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-home-paths": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-jobs": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-llm-retry": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-native-command": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-ptc-runtime": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection-cache": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-query": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-title": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-settings": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-skill": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-skill-filesystem": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-storage": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-storage-domain": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-timeout": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-tool-subagent": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-tool-todo": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-registry": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-user-approval": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-util-crypto": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-util-time": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-util-values": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-util-workspace-path": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-workspace": "^0.2.1-rc.3",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@mstar-harness/engine": "^4.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-theme": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "0.2.1-rc.3",
    "@deepseek-ai/dsh-util-code-language": "0.2.1-rc.3",
    "@mstar-harness/commands": "workspace:*",
    "@mstar-harness/engine": "workspace:*",
    "@mstar-harness/ui": "workspace:*",
    "@shikijs/langs": "^4.5.0",
    "@tanstack/react-virtual": "3.14.22",
    "@types/node": "^26.6.4",
    "@types/react": "~18.3.1",
    "anser": "^2.3.5",
    "bun-types": "^1.4.4",
    "clsx": "^2.0.0",
    "diff": "^9.0.0",
    "dsh-llm-fallbacks": "0.6.8",
    "immer": "^11.2.9",
    "js-yaml": "^5.4.3",
    "katex": "^0.19.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.4",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^4.5.0",
    "simple-icons": "16.35.0",
    "typescript": "^7.0.2",
    "use-sync-external-store": "1.7.0",
    "vitest": "^5.0.3",
    "zustand": "~5.0.16"
  }
}

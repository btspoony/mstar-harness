{
  "name": "@mstar-harness/dsh",
  "version": "2.1.1",
  "description": "Morning Star harness dsh (DeepSeek Harness) cordis function plugin — in-process engine gates (status/dispatch/lease) with hard refusal channels.",
  "keywords": [
    "dsh",
    "dsh-plugin"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./invariant": {
      "types": "./dist/invariant.d.ts",
      "default": "./dist/invariant.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./bundle/cordis.patch.yml": "./bundle/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bundle",
    "harness-skills",
    "harness-commands"
  ],
  "dsh": {
    "bundle": {
      "patch": "./bundle/cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "pretest": "bun run build-client",
    "test": "bun test",
    "typecheck:tests": "bunx tsc --noEmit -p tests/tsconfig.json",
    "bundle-assets": "bun run scripts/bundle-harness-assets.ts",
    "build": "bun run bundle-assets && rm -rf dist && bun build src/index.ts src/invariant.ts --target node --outdir dist --external @deepseek-ai/cordis --external @deepseek-ai/dsh-skill-filesystem --external @deepseek-ai/dsh-tools --external @deepseek-ai/dsh-llm && bun run build-client && bunx tsc",
    "build-client": "bun run scripts/build-client-bundle.ts",
    "prepare": "bun run build",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "bun": ">=1.2.17"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-agent": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-client-locale": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-client-runtime": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-commands": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-fs": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-invariants": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-jobs": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-skill": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-skill-filesystem": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@mstar-harness/engine": "2.1.1",
    "@types/node": "^25.6.0",
    "@types/react": "~18.3.1",
    "js-yaml": "^4.1.0",
    "bun-types": "^1.2.17",
    "schemastery": "^3.18.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}

{
  "name": "@mstar-harness/dsh",
  "version": "2.0.6",
  "description": "Morning Star harness dsh (DeepSeek Harness) cordis function plugin — in-process engine gates (status/dispatch/lease) with hard refusal channels.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./invariant": {
      "types": "./dist/invariant.d.ts",
      "default": "./dist/invariant.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./bundle/cordis.patch.yml": "./bundle/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bundle",
    "harness-skills",
    "harness-commands"
  ],
  "dsh": {
    "bundle": {
      "patch": "./bundle/cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "pretest": "bun run build-client",
    "test": "bun test",
    "typecheck:tests": "bunx tsc --noEmit -p tests/tsconfig.json",
    "dsh:link": "bun run scripts/setup-dsh-links.ts",
    "dsh:link:check": "bun run scripts/setup-dsh-links.ts --check",
    "bundle-assets": "bun run scripts/bundle-harness-assets.ts",
    "build": "bun run bundle-assets && rm -rf dist && bun build src/index.ts src/invariant.ts --target node --outdir dist --external cordis --external @deepseek-ai/dsh-skill-local --external @deepseek-ai/dsh-tools --external @deepseek-ai/dsh-llm && bun run build-client && bunx tsc",
    "build-client": "bun run scripts/build-client-bundle.ts",
    "prepare": "bun run scripts/setup-dsh-links.ts && bun run build",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "bun": ">=1.2.17"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.0.1",
    "@deepseek-ai/dsh-commands": "^0.0.1",
    "@deepseek-ai/dsh-fs": "^0.0.1",
    "@deepseek-ai/dsh-llm": "^0.0.1",
    "@deepseek-ai/dsh-skill": "^0.0.1",
    "@deepseek-ai/dsh-skill-local": "^0.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1",
    "cordis": "^4.0.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-commands": { "optional": true },
    "@deepseek-ai/dsh-fs": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-skill": { "optional": true },
    "@deepseek-ai/dsh-skill-local": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@cordisjs/plugin-include": "1.0.4",
    "@cordisjs/plugin-loader": "1.0.0-rc.5",
    "@mstar-harness/engine": "2.1.1",
    "@types/node": "^25.6.0",
    "@types/react": "~18.3.1",
    "js-yaml": "^4.1.0",
    "bun-types": "^1.2.17",
    "cordis": "^4.0.0-rc.7",
    "schemastery": "^3.18.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}

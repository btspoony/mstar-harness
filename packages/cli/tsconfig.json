{
  // The CLI was previously outside every tsc project (the root tsconfig
  // `include` lists only packages/opencode/src/mstar.ts, tools/** and hooks/**),
  // so a type error here — including an unresolved type name in an assertion —
  // was invisible to `bun run typecheck` and to CI, which only bundles the file
  // with `bun build` (no type checking). This project closes that hole.
  //
  // `types: ["node"]` resolves @types/node from the repo root. The one in-src
  // spec (`global-cli.test.ts`) needs bun test types, which no tsc project in
  // this package provides yet — it is excluded rather than silently mis-typed;
  // package tests live in `test/` and run under `bun test`.
  //
  // The dashboard server and generated assets are owned by @mstar-harness/commands;
  // the web asset generator remains in CLI build/typecheck order so fresh builds
  // write the module consumed by that package.
  //
  // `web/` is included here rather than in a second project: a separate config is
  // the thing a later edit forgets to update, and the React tree would then ship
  // typechecked by nothing. `jsx: react-jsx` matches the shared package, and the
  // DOM libs are what its components are written against.
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "web"],
  // Package tests run under `bun test`, which no tsc project here serves types
  // for; excluding them keeps the production tree typechecked without pretending
  // to check the fixtures. `scripts/` stays out too: the generator is a Bun script
  // with Bun globals, and it has its own suite under `bun test`.
  "exclude": ["src/**/*.test.ts", "web/**/*.test.ts", "web/**/*.test.tsx"]
}

{
  "name": "@mstar-harness/judgment",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/judgment/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/judgment/src/index.d.ts",
      "default": "./dist/index.js"
    },
    "./shadow": {
      "types": "./dist/judgment/scripts/shadow.d.ts",
      "default": "./dist/shadow.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --target node --outfile dist/index.js && bun build scripts/shadow.ts --target node --outfile dist/shadow.js && bunx tsc"
  },
  "devDependencies": {
    "@mstar-harness/engine": "workspace:*",
    "@types/node": "^25.6.0",
    "bun-types": "^1.2.17",
    "typescript": "^5.9.3"
  }
}

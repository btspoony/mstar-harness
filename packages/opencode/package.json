{
  "name": "@mstar-harness/opencode",
  "version": "3.6.0-alpha.4",
  "description": "Morning Star harness OpenCode plugin — skills bootstrap + engine-backed runtime hooks (status lint, dispatch validation, Enforcement: hard gates).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/btspoony/mstar-harness.git",
    "directory": "packages/opencode"
  },
  "type": "module",
  "main": "./dist/mstar.js",
  "files": [
    "dist",
    "harness-skills",
    "harness-agents",
    "harness-commands",
    "AGENTS.md",
    "INSTALL.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "bundle-assets": "bun run scripts/bundle-harness-assets.ts",
    "build": "bun run bundle-assets && rm -rf dist && bun build src/mstar.ts --target node --outfile dist/mstar.js",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "bun": ">=1.2.17"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.4.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@mstar-harness/engine": "workspace:*"
  }
}

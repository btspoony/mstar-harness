; Morning Star harness layout for this repository.
; Values mirror the resolved layout so later candidate-chain drift cannot move them.
[config]
adr_dir=docs/adr
knowledge_dir=docs/knowledge
specs_dir=docs/specs

; Collaboration authority: the local user-level lane owns issues, findings,
; projects, roadmaps and catalog identity. No provider mirror is declared.
[collaboration]
mode=local
